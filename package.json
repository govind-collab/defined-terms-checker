{
  "name": "defined-terms-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Word add-in that checks the defined terms in a contract: used but never defined, defined but never used, defined twice, used before an inline definition, and lowercase uses.",
  "author": "Govind Sajithkumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/govind-collab/defined-terms-checker.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/office-js": "^1.0.608",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.10.0",
    "globals": "^16.0.0",
    "html-webpack-plugin": "^5.6.8",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
